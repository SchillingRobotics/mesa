#!/bin/sh
# Respawn wrapper for schilling-node-app.
# Restarts the application after an unexpected exit, with a brief delay
# to prevent rapid restart loops.

# TODO(Trevor): Change back to /usr/bin/schilling-node-app for production
DAEMON=/mnt/schilling/schilling-node-app
RESPAWN_DELAY_SECS=3

# Verify the app binary exists before entering the respawn loop
if [ ! -x "$DAEMON" ]; then
    logger -t schilling-node-app "ERROR: $DAEMON not found or not executable"
    echo "ERROR: $DAEMON not found or not executable" >&2
    exit 1
fi

# Redirect output to console so log messages are visible
exec > /dev/console 2>&1

# Source environment from writable partition
[ -f /mnt/schilling/node_profile ] && . /mnt/schilling/node_profile

# Trap SIGTERM/SIGINT to cleanly stop the app and exit
APP_PID=
trap 'kill $APP_PID 2>/dev/null; exit 0' TERM INT

while true; do
    "$DAEMON" &
    APP_PID=$!
    wait $APP_PID
    rc=$?
    APP_PID=
    logger -t schilling-node-app "exited with code $rc, restarting in ${RESPAWN_DELAY_SECS}s"
    sleep "$RESPAWN_DELAY_SECS"
done
